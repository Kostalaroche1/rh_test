{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/access/layout,_N_T_/dashboard/access/page,_N_T_/dashboard/access"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/access/__PAGE__",
    "/dashboard/access",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}